# Bitnox Technology Solutions: environment
#
# Copy to `.env` and fill in every value. `src/lib/env.ts` validates this file with Zod at boot,
# so a missing or malformed variable fails the build rather than surfacing at runtime.
#
# Variables prefixed NEXT_PUBLIC_ are inlined into the browser bundle. Everything else is
# server-only and must never be referenced from a client component.

# --- Database ---------------------------------------------------------------
# New, empty database. Nothing is migrated from the legacy Express app. Use separate
# databases for development and production. The name must appear in the allowlist in
# scripts/reset-db.ts before `db:reset` will touch it.
MONGO_URI=mongodb://127.0.0.1:27017/bitnox_dev

# --- Auth -------------------------------------------------------------------
# Signs the session cookie. At least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# --- Email ------------------------------------------------------------------
# Resend, used for login OTP, password reset and enquiry acknowledgements.
RESEND_API_KEY=

# --- Uploads ----------------------------------------------------------------
# The key and secret are server-only. They are what make signed uploads possible,
# so no unsigned preset ships to production.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# --- Scheduled jobs ---------------------------------------------------------
# Authorises the scheduled-publish route handler. Any long random string.
CRON_SECRET=

# --- Site -------------------------------------------------------------------
# Drives metadataBase, canonicals and the sitemap. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_EDU_URL=https://edu.bitnoxsolution.com
NEXT_PUBLIC_CLEANING_URL=https://cleaning.bitnoxsolution.com

# --- Analytics and search ---------------------------------------------------
# Both optional in development. Supply before launch.
NEXT_PUBLIC_GTM_ID=
GOOGLE_SITE_VERIFICATION=
